{
	"name": "my-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:migrate": "bun --bun knex migrate:latest",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:smoke": "node --no-experimental-detect-module --test test/server-smoke.test.mjs",
		"format": "prettier --write ."
	},
	"dependencies": {
		"gsap": "^3.15.0",
		"highlight.js": "^11.12.0",
		"knex": "^3.3.0",
		"marked": "^18.1.2",
		"marked-highlight": "^2.2.4",
		"pg": "^8.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
